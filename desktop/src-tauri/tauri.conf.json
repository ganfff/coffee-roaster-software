{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RoasterDesktop",
  "version": "0.1.0",
  "identifier": "com.ganf.roaster",
  "build": {
    "frontendDist": "../../roaster/static"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "咖啡烘焙机控制台",
        "width": 1366,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
