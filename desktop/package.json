{
  "name": "roaster-desktop",
  "private": true,
  "version": "0.6.2",
  "description": "咖啡烘焙机控制台 — Tauri 桌面壳（复用 roaster/static 前端）",
  "scripts": {
    "prepare:ai": "node tools/prepare-ai.mjs",
    "prepare:workbench": "node tools/prepare-workbench.mjs",
    "test:workbench:ui": "node tools/test-workbench-ui.mjs",
    "test:ai": "node --test ai/*.test.mjs",
    "test:ai:ui": "node tools/test-ai-chat-ui.mjs",
    "tauri": "tauri",
    "dev": "tauri dev",
    "dev:sim": "node tools/dev-sim.mjs",
    "simulator": "node tools/roaster-simulator.mjs",
    "icons:sync": "node tools/sync-icons.mjs",
    "check:frontend": "node tools/check-frontend.mjs",
    "check:themes": "node tools/theme-palettes.mjs --check",
    "test:local-ai:ui": "node tools/test-local-ai-ui.mjs",
    "test:editor:session": "node tools/test-editor-session-ui.mjs",
    "test:instrument:ui": "node tools/test-instrument-ui.mjs",
    "test:instrument:native": "node tools/test-instrument-native.mjs",
    "build": "tauri build",
    "build:debug": "tauri build --debug",
    "test:workbench:native-ui": "node ../roaster/tests/test_workbench_native_ui.mjs",
    "package:ai:arm64": "node tools/package-ai-arm64.mjs",
    "test:ai:native-ui": "node tools/test-ai-chat-ui.mjs --native",
    "test:atlas:ui": "node tools/test-atlas-ui.mjs",
    "dev:web": "node tools/dev-server.mjs",
    "test:dev": "node tools/test-dev-server.mjs",
    "test:dev:native": "node tools/test-dev-native.mjs"
  },
  "devDependencies": {
    "@phosphor-icons/web": "2.1.2",
    "@tauri-apps/cli": "^2",
    "playwright": "^1.64.1",
    "esbuild": "^0.28.2",
    "ws": "^8.18.3"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@tauri-apps/api": "2.11.1"
  }
}
